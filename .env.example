# ==============================================================================
# Orbit Maestro — Environment Configuration Template
# Copy this file to .env and populate with your own environment values.
# IMPORTANT: Never commit .env with real secrets to source control.
# ==============================================================================

# Google Cloud Platform Environment
PROJECT_ID=your-gcp-project-id
REGION=us-central1
ENVIRONMENT=dev
GEMINI_MODEL=gemini-2.5-flash
BIGQUERY_DATASET=scrum_delivery_analytics
FIRESTORE_DATABASE=(default)
# DOCUMENT_AI_PROCESSOR_ID=projects/YOUR_PROJECT_NUMBER/locations/us/processors/YOUR_PROCESSOR_ID
# PRD_BUCKET_NAME=your-gcp-project-id-prd-uploads

# Atlassian Jira & Confluence Integration (Required for Enterprise Sync mode)
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=SCRUM

CONFLUENCE_INSTANCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USER_EMAIL=your-email@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token

# GitHub Integration (Commit tracking & Flash Health)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_API_BASE=https://api.github.com

# Google OAuth 2.0 Web Client (Calendar & Drive integration)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# Next.js Frontend Configuration (Available in browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_JIRA_INSTANCE_URL=https://your-domain.atlassian.net

# API Server Port & Network Security
PORT=8000
CORS_ORIGINS=*
